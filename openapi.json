                          "status": {
                            "type": "string",
                            "enum": [
                              "queued",
                              "starting",
                              "online",
                              "offline",
                              "error"
                            ]
                          },
                          "action": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
