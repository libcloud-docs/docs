  "paths": {
    "/me/plan": {
      "get": {
        "summary": "Consultar plano",
        "operationId": "get_me_plan",
        "description": "Consulta autenticada, sujeita as cotas da conta.",
        "x-mint": {
          "href": "/api-reference/get-me-plan"
        },
        "responses": {
          "200": {
            "description": "Resposta da API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "billing",
                        "admin",
                        "free"
                      ]
                    },
                    "priceCents": {
                      "type": "integer",
                      "nullable": true
                    },
                    "expiresAt": {
                      "type": "integer",
                      "nullable": true
                    },
                    "mode": {
                      "type": "string",
                      "nullable": true,
                      "enum": [
                        "one_time",
                        "subscription",
                        null
                      ]
                    },
                    "memoryMiB": {
                      "type": "number"
                    },
                    "cpu": {
                      "type": "number"
                    },
                    "diskMiB": {
                      "type": "number"
                    },
                    "apiRequestsHour": {
                      "type": "integer"
                    },
                    "apiRequestsDay": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Erro: consulte limites e erros da API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
